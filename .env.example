# Agnes official API. Never commit real keys.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Where the web agent may read/write files (server disk). Desktop overrides this by picking a folder.
WORKSPACE_ROOT=./data/workspace

# SQLite + generated media (web/self-host). Electron ignores this and uses OS userData/data.
DATA_DIR=./data

# HTTP listen. Local desktop binds 127.0.0.1 automatically.
PORT=8787
HOST=127.0.0.1

# Optional visitor lock for a public web. Leave empty for local use.
APP_AUTH_TOKEN=

# Default models (OpenAI-compatible names)
AGNES_CHAT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# Agent writes apply immediately when true. Keep false on a public server.
AUTO_APPLY=false

# Ignored on the web server. Terminal exists only in local Electron.
ALLOW_TERMINAL=false

# Agent file writes (diff apply / upload / write_file). Keep true for normal use.
ALLOW_WRITES=true

# Optional CORS origin. Leave empty for same-origin only (recommended).
CORS_ORIGIN=

# Honor X-Real-IP / X-Forwarded-For only from a trusted hop. Leave false if Node is exposed directly.
TRUST_PROXY=false

# This open-source demo is local-authority only.
# Leave LICENSE_SERVER_URL empty so the process uses your AGNES_API_KEY directly.
# Do not point this at any commercial card-key / relay host.
LICENSE_SERVER_URL=