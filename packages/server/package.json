{
  "name": "@agnes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:hardening": "tsx src/hardening-check.ts",
    "check:agent": "tsx src/agent-e2e.ts"
  },
  "dependencies": {
    "@agnes/agent": "workspace:*",
    "@agnes/sdk": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "dotenv": "^17.2.2",
    "hono": "^4.9.8",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2"
  }
}